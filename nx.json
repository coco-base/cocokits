{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/tests/**",
      "!{projectRoot}/src/generated/**/*"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/compatibility.json",
      "{workspaceRoot}/LICENSE"
    ],
    "executors": [
      "{workspaceRoot}/tools/workspace-plugin/executors.json",
      "{workspaceRoot}/tools/workspace-plugin/src/executors/**/*.ts",
      "!{workspaceRoot}/tools/workspace-plugin/src/executors/**/*.spec.ts"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test"
      }
    }
  ],
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^build"]
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{projectRoot}/eslint.config.mjs",
        "{workspaceRoot}/tsconfig.strict.json",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        { "externalDependencies": ["eslint"] },
        "{workspaceRoot}/tools/eslint/**/*"
      ]
    },
    "docs-data": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": [
        "production",
        "^production",
        "executors",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": true
        }
      ],
      "outputs": ["{workspaceRoot}/dist/docs-data/{projectName}"]
    },
    "api-docs": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "production",
        "^production",
        "executors",
        "{workspaceRoot}/packages/shared/src/**/*.ts",
        "{workspaceRoot}/packages/machines/**/*.types.ts"
      ],
      "outputs": ["{workspaceRoot}/dist/api-docs/{projectName}"]
    },
    "pack": {
      "cache": true,
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/package-checks.mjs pack {projectName}",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/tarballs/{projectName}"],
      "inputs": [
        "default",
        "{workspaceRoot}/tools/scripts/package-checks.mjs",
        "{workspaceRoot}/tools/scripts/package-manifest.mjs",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": false
        }
      ]
    },
    "publint": {
      "cache": true,
      "dependsOn": ["build", "pack"],
      "inputs": [
        "default",
        "{workspaceRoot}/tools/scripts/package-checks.mjs",
        "{workspaceRoot}/tools/scripts/package-manifest.mjs",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": false
        }
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/package-checks.mjs publint {projectName}",
        "cwd": "{workspaceRoot}"
      }
    },
    "attw": {
      "cache": true,
      "dependsOn": ["pack"],
      "inputs": [
        "default",
        "{workspaceRoot}/tools/scripts/package-checks.mjs",
        "{workspaceRoot}/tools/scripts/package-manifest.mjs",
        {
          "dependentTasksOutputFiles": "**/*.tgz",
          "transitive": false
        }
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/package-checks.mjs attw {projectName}",
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "release": null
}
