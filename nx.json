{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/tests/**",
      "!{projectRoot}/src/generated/**/*"
    ],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/compatibility.json"],
    "executors": [
      "{workspaceRoot}/tools/workspace-plugin/executors.json",
      "{workspaceRoot}/tools/workspace-plugin/src/executors/**/*.ts",
      "!{workspaceRoot}/tools/workspace-plugin/src/executors/**/*.spec.ts"
    ]
  },
  "plugins": [
    { "plugin": "@nx/eslint/plugin", "options": { "targetName": "lint" } },
    { "plugin": "@nx/vitest", "options": { "testTargetName": "test" } }
  ],
  "targetDefaults": {
    "build": { "cache": true, "dependsOn": ["^build"], "inputs": ["production", "^production"] },
    "typecheck": { "cache": true, "dependsOn": ["^build"] },
    "test": { "cache": true, "dependsOn": ["^build"], "inputs": ["default", "^production"] },
    "lint": { "cache": true },
    "pack": { "cache": true, "dependsOn": ["build"], "outputs": ["{workspaceRoot}/dist/tarballs/{projectName}"] },
    "publint": { "cache": true, "dependsOn": ["pack"] },
    "attw": { "cache": true, "dependsOn": ["pack"] },
    "size": { "cache": true, "dependsOn": ["build"] },
    "api-report": { "cache": true, "dependsOn": ["build"], "outputs": ["{projectRoot}/api"] },
    "dom-contract": { "cache": true, "dependsOn": ["build"], "outputs": ["{projectRoot}/dom-contract"] },
    "docs-data": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["production", "^production", "executors", { "dependentTasksOutputFiles": "**/*", "transitive": true }],
      "outputs": ["{projectRoot}/src/generated/docs-data"]
    },
    "api-docs": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "production",
        "^production",
        "executors",
        "{workspaceRoot}/packages/shared/src/**/*.ts",
        "{workspaceRoot}/packages/machines/**/*.types.ts"
      ],
      "outputs": ["{projectRoot}/src/generated/api-docs"]
    },
    "smoke": { "cache": false, "dependsOn": ["build"] }
  },
  "release": null
}
