{
  "shadow-xs": {
    "$type": "shadow",
    "$value": {
      "offsetX": "0px",
      "offsetY": "1px",
      "blur": "2px",
      "spread": "0px",
      "color": "{black-alpha.10}"
    }
  },
  "shadow-sm": {
    "$type": "shadow",
    "$value": [
      { "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px", "color": "{black-alpha.10}" },
      { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "-1px", "color": "{black-alpha.10}" }
    ]
  },
  "shadow-md": {
    "$type": "shadow",
    "$value": [
      { "offsetX": "0px", "offsetY": "4px", "blur": "6px", "spread": "-1px", "color": "{black-alpha.10}" },
      { "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "-2px", "color": "{black-alpha.10}" }
    ]
  },
  "shadow-lg": {
    "$type": "shadow",
    "$value": [
      { "offsetX": "0px", "offsetY": "10px", "blur": "15px", "spread": "-3px", "color": "{black-alpha.10}" },
      { "offsetX": "0px", "offsetY": "4px",  "blur": "6px",  "spread": "-4px", "color": "{black-alpha.10}" }
    ]
  },
  "shadow-xl": {
    "$type": "shadow",
    "$value": [
      { "offsetX": "0px", "offsetY": "20px", "blur": "25px", "spread": "-5px",  "color": "{black-alpha.10}" },
      { "offsetX": "0px", "offsetY": "8px",  "blur": "10px", "spread": "-6px",  "color": "{black-alpha.10}" }
    ]
  },
  "shadow-2xl": {
    "$type": "shadow",
    "$value": {
      "offsetX": "0px",
      "offsetY": "25px",
      "blur": "50px",
      "spread": "-12px",
      "color": "{black-alpha.30}"
    }
  },
  "shadow-inner": {
    "$type": "shadow",
    "$value": {
      "offsetX": "0px",
      "offsetY": "2px",
      "blur": "4px",
      "spread": "0px",
      "color": "{black-alpha.10}",
      "inset": true
    }
  }
}
