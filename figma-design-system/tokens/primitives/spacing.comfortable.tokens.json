{
  "$description": "Spacing Comfortable mode — generous scale for spacious UIs. Shifts Normal values one step up. 0→0, 1→2, 2→4, 3→6, 4→10, then: 16, 20, 32, 40, 64, 80, 128, 160. Used ONLY for margin, padding, and gap. Best for landing pages, docs, reading apps.",

  "spacing-0":  { "$type": "dimension", "$value": "0px" },
  "spacing-1":  { "$type": "dimension", "$value": "{size-2}" },
  "spacing-2":  { "$type": "dimension", "$value": "{size-4}" },
  "spacing-3":  { "$type": "dimension", "$value": "{size-6}" },
  "spacing-4":  { "$type": "dimension", "$value": "{size-10}" },
  "spacing-5":  { "$type": "dimension", "$value": "{size-16}" },
  "spacing-6":  { "$type": "dimension", "$value": "{size-20}" },
  "spacing-7":  { "$type": "dimension", "$value": "{size-32}" },
  "spacing-8":  { "$type": "dimension", "$value": "{size-40}" },
  "spacing-9":  { "$type": "dimension", "$value": "{size-64}" },
  "spacing-10": { "$type": "dimension", "$value": "{size-80}" },
  "spacing-11": { "$type": "dimension", "$value": "{size-128}" },
  "spacing-12": { "$type": "dimension", "$value": "{size-160}" }
}
