{
  "$description": "Spacing Compact mode — tighter scale for dense UIs. Shifts Normal values one step down. 0→0, 1→1, 2→2, 3→2, 4→4, then: 8, 12, 16, 24, 32, 48, 64, 96. Used ONLY for margin, padding, and gap. Best for tables, dashboards, admin panels.",

  "spacing-0":  { "$type": "dimension", "$value": "0px" },
  "spacing-1":  { "$type": "dimension", "$value": "{size-1}" },
  "spacing-2":  { "$type": "dimension", "$value": "{size-2}" },
  "spacing-3":  { "$type": "dimension", "$value": "{size-2}" },
  "spacing-4":  { "$type": "dimension", "$value": "{size-4}" },
  "spacing-5":  { "$type": "dimension", "$value": "{size-8}" },
  "spacing-6":  { "$type": "dimension", "$value": "{size-12}" },
  "spacing-7":  { "$type": "dimension", "$value": "{size-16}" },
  "spacing-8":  { "$type": "dimension", "$value": "{size-24}" },
  "spacing-9":  { "$type": "dimension", "$value": "{size-32}" },
  "spacing-10": { "$type": "dimension", "$value": "{size-48}" },
  "spacing-11": { "$type": "dimension", "$value": "{size-64}" },
  "spacing-12": { "$type": "dimension", "$value": "{size-96}" }
}
