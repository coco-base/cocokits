{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "angular",
  "projectType": "library",
  "sourceRoot": "packages/angular",
  "tags": ["layer:fw-component", "scope:angular", "type:lib"],
  "targets": {
    "package": {
      "executor": "@nx/angular:package",
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/dist/packages/angular"],
      "options": {
        "project": "{projectRoot}/ng-package.json",
        "tsConfig": "{projectRoot}/tsconfig.lib.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "package"],
      "inputs": ["production", "^production", "{workspaceRoot}/tools/scripts/finalize-ng-package.mjs"],
      "outputs": ["{workspaceRoot}/dist/packages/angular"],
      "options": {
        "command": "node ../../tools/scripts/finalize-ng-package.mjs --strip-root",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc --noEmit -p tsconfig.lib.json", "tsc --noEmit -p tsconfig.spec.json"],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "api-docs": {
      "executor": "@cocokits/workspace:api-docs-angular"
    },
    "cycles": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.dependency-cruiser.cjs"],
      "options": {
        "command": "depcruise {projectRoot} --config .dependency-cruiser.cjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "dependsOn": ["cycles"]
    },
    "pack": {},
    "publint": {},
    "attw": {}
  }
}
