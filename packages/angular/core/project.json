{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "angular-core",
  "projectType": "library",
  "sourceRoot": "packages/angular/core/src",
  "tags": ["layer:fw-core", "scope:angular", "type:lib"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/packages/angular-core"],
      "options": {
        "project": "{projectRoot}/ng-package.build.json",
        "tsConfig": "{projectRoot}/tsconfig.lib.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc --noEmit -p tsconfig.lib.json", "tsc --noEmit -p tsconfig.spec.json"],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    }
  }
}
