{
  "$meta": { "globalPrefix": "cck" },
  "collections": [
    {
      "name": "Switch / Size",
      "tier": 3,
      "prefix": "switch",
      "defaultMode": "md",
      "modes": ["sm", "md", "lg"],
      "tokens": [
        { "name": "track-width", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Core / Size#size-28}", "md": "{Core / Size#size-36}", "lg": "{Core / Size#size-44}" } },
        { "name": "track-height", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Core / Size#size-16}", "md": "{Core / Size#size-20}", "lg": "{Core / Size#size-24}" } },
        { "name": "thumb-size", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Core / Size#size-12}", "md": "{Core / Size#size-16}", "lg": "{Core / Size#size-20}" } },
        { "name": "rail-track-width", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Core / Size#size-24}", "md": "{Core / Size#size-32}", "lg": "{Core / Size#size-40}" } },
        { "name": "rail-track-height", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Core / Size#size-6}", "md": "{Core / Size#size-8}", "lg": "{Core / Size#size-10}" } },
        { "name": "label-font-family", "type": "string", "valuesByMode": { "sm": "{Theme / Typography#text-sm/font-family}", "md": "{Theme / Typography#text-sm/font-family}", "lg": "{Theme / Typography#text-sm/font-family}" } },
        { "name": "label-font-size", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Typography#text-sm/font-size}", "md": "{Theme / Typography#text-sm/font-size}", "lg": "{Theme / Typography#text-sm/font-size}" } },
        { "name": "label-line-height", "type": "number", "unit": "unitless", "valuesByMode": { "sm": "{Theme / Typography#text-sm/line-height}", "md": "{Theme / Typography#text-sm/line-height}", "lg": "{Theme / Typography#text-sm/line-height}" } },
        { "name": "label-letter-spacing", "type": "number", "unit": "em", "valuesByMode": { "sm": "{Theme / Typography#text-sm/letter-spacing}", "md": "{Theme / Typography#text-sm/letter-spacing}", "lg": "{Theme / Typography#text-sm/letter-spacing}" } }
      ]
    },
    {
      "name": "Switch / Structure",
      "tier": 3,
      "prefix": "switch",
      "defaultMode": "Default",
      "modes": ["Default"],
      "tokens": [
        { "name": "hit-size", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Core / Size#size-24}" } },
        { "name": "gap", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-4}" } },
        { "name": "thumb-offset", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Core / Size#size-2}" } },
        { "name": "track-radius", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Radius#radius-full}" } },
        { "name": "track-border-width", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Border Width#border-width-1}" } },
        { "name": "track-bg", "type": "color", "valuesByMode": { "Default": "{Theme / Color#surface/3}" } },
        { "name": "track-ink", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/1}" } },
        { "name": "track-readonly-border-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#border/3}" } },
        { "name": "track-checked-bg", "type": "color", "valuesByMode": { "Default": "{Theme / Active Color#color}" } },
        { "name": "track-invalid-border-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#danger/color}" } },
        { "name": "thumb-color", "type": "color", "valuesByMode": { "Default": "{Core / Color#white}" } },
        { "name": "thumb-checked-color", "type": "color", "valuesByMode": { "Default": "{Theme / Active Color#on-color}" } },
        { "name": "thumb-shadow", "type": "string", "valuesByMode": { "Default": "{Theme / Shadow#shadow-sm}" } },
        { "name": "rail-thumb-border-width", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Border Width#border-width-1}" } },
        { "name": "rail-thumb-border-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#border/3}" } },
        { "name": "label-font-weight", "type": "number", "unit": "unitless", "valuesByMode": { "Default": "{Core / Typography#font-weight/regular}" } },
        { "name": "label-text-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/1}" } },
        { "name": "hover-mix", "type": "number", "unit": "%", "valuesByMode": { "Default": "{Theme / Opacity#opacity-10}" } },
        { "name": "active-mix", "type": "number", "unit": "%", "valuesByMode": { "Default": "{Theme / Opacity#opacity-20}" } },
        { "name": "focus-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#focus/2}" } },
        { "name": "focus-width", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Border Width#border-width-2}" } },
        { "name": "focus-offset", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-2}" } },
        { "name": "disabled-opacity", "type": "number", "unit": "%", "valuesByMode": { "Default": "{Theme / Opacity#opacity-50}" } }
      ]
    }
  ]
}
