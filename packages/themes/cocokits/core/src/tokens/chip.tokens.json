{
  "$meta": { "globalPrefix": "cck" },
  "collections": [
    {
      "name": "Chip / Size",
      "tier": 3,
      "prefix": "chip",
      "defaultMode": "md",
      "modes": ["sm", "md", "lg"],
      "tokens": [
        { "name": "height", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Spacing#control-xs}", "md": "{Theme / Spacing#control-xs}", "lg": "{Theme / Spacing#control-sm}" } },
        { "name": "padding-inline", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Spacing#spacing-3}", "md": "{Theme / Spacing#spacing-4}", "lg": "{Theme / Spacing#spacing-5}" } },
        { "name": "remove-end-inset", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Spacing#spacing-2}", "md": "{Theme / Spacing#spacing-3}", "lg": "{Theme / Spacing#spacing-3}" } },
        { "name": "font-family", "type": "string", "valuesByMode": { "sm": "{Theme / Typography#text-xs/font-family}", "md": "{Theme / Typography#text-xs/font-family}", "lg": "{Theme / Typography#text-sm/font-family}" } },
        { "name": "font-size", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Typography#text-xs/font-size}", "md": "{Theme / Typography#text-xs/font-size}", "lg": "{Theme / Typography#text-sm/font-size}" } },
        { "name": "line-height", "type": "number", "unit": "unitless", "valuesByMode": { "sm": "{Theme / Typography#text-xs/line-height}", "md": "{Theme / Typography#text-xs/line-height}", "lg": "{Theme / Typography#text-sm/line-height}" } },
        { "name": "letter-spacing", "type": "number", "unit": "em", "valuesByMode": { "sm": "{Theme / Typography#text-xs/letter-spacing}", "md": "{Theme / Typography#text-xs/letter-spacing}", "lg": "{Theme / Typography#text-sm/letter-spacing}" } },
        { "name": "icon-size", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Core / Size#size-14}", "md": "{Core / Size#size-14}", "lg": "{Core / Size#size-16}" } },
        { "name": "check-icon-size", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Core / Size#size-14}", "md": "{Core / Size#size-14}", "lg": "{Core / Size#size-16}" } },
        { "name": "check-padding-inline-start", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Spacing#spacing-3}", "md": "{Theme / Spacing#spacing-3}", "lg": "{Theme / Spacing#spacing-4}" } }
      ]
    },
    {
      "name": "Chip / Structure",
      "tier": 3,
      "prefix": "chip",
      "defaultMode": "Default",
      "modes": ["Default"],
      "tokens": [
        { "name": "radius", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Radius#radius-full}" } },
        { "name": "gap", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-3}" } },
        { "name": "border-width", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Border Width#border-width-1}" } },
        { "name": "bg", "type": "color", "valuesByMode": { "Default": "{Theme / Color#surface/2}" } },
        { "name": "text-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/1}" } },
        { "name": "font-weight", "type": "number", "unit": "unitless", "valuesByMode": { "Default": "{Core / Typography#font-weight/medium}" } },
        { "name": "selected-bg", "type": "color", "valuesByMode": { "Default": "{Theme / Color#brand/color}" } },
        { "name": "selected-text-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#brand/on-color}" } },
        { "name": "remove-padding", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-2}" } },
        { "name": "remove-hit-size", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Core / Size#size-24}" } },
        { "name": "remove-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/3}" } },
        { "name": "hover-mix", "type": "number", "unit": "%", "valuesByMode": { "Default": "{Theme / Opacity#opacity-10}" } },
        { "name": "active-mix", "type": "number", "unit": "%", "valuesByMode": { "Default": "{Theme / Opacity#opacity-20}" } },
        { "name": "focus-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#focus/2}" } },
        { "name": "focus-width", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Border Width#border-width-2}" } },
        { "name": "focus-offset", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-2}" } },
        { "name": "disabled-opacity", "type": "number", "unit": "%", "valuesByMode": { "Default": "{Theme / Opacity#opacity-50}" } }
      ]
    },
    {
      "name": "Chip List / Size",
      "tier": 3,
      "prefix": "chip-list",
      "defaultMode": "md",
      "modes": ["sm", "md", "lg"],
      "tokens": [
        { "name": "height", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Spacing#control-sm}", "md": "{Theme / Spacing#control-md}", "lg": "{Theme / Spacing#control-lg}" } },
        { "name": "padding-inline", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Spacing#spacing-4}", "md": "{Theme / Spacing#spacing-5}", "lg": "{Theme / Spacing#spacing-5}" } },
        { "name": "gap", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Spacing#spacing-3}", "md": "{Theme / Spacing#spacing-3}", "lg": "{Theme / Spacing#spacing-4}" } },
        { "name": "font-family", "type": "string", "valuesByMode": { "sm": "{Theme / Typography#text-sm/font-family}", "md": "{Theme / Typography#text-sm/font-family}", "lg": "{Theme / Typography#text-sm/font-family}" } },
        { "name": "font-size", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Typography#text-sm/font-size}", "md": "{Theme / Typography#text-sm/font-size}", "lg": "{Theme / Typography#text-sm/font-size}" } },
        { "name": "line-height", "type": "number", "unit": "unitless", "valuesByMode": { "sm": "{Theme / Typography#text-sm/line-height}", "md": "{Theme / Typography#text-sm/line-height}", "lg": "{Theme / Typography#text-sm/line-height}" } },
        { "name": "letter-spacing", "type": "number", "unit": "em", "valuesByMode": { "sm": "{Theme / Typography#text-sm/letter-spacing}", "md": "{Theme / Typography#text-sm/letter-spacing}", "lg": "{Theme / Typography#text-sm/letter-spacing}" } },
        { "name": "chip-height", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Spacing#control-xs}", "md": "{Theme / Spacing#control-xs}", "lg": "{Theme / Spacing#control-sm}" } },
        { "name": "chip-padding-inline", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Spacing#spacing-4}", "md": "{Theme / Spacing#spacing-4}", "lg": "{Theme / Spacing#spacing-5}" } },
        { "name": "chip-gap", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Spacing#spacing-3}", "md": "{Theme / Spacing#spacing-3}", "lg": "{Theme / Spacing#spacing-3}" } },
        { "name": "chip-remove-end-inset", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Spacing#spacing-3}", "md": "{Theme / Spacing#spacing-3}", "lg": "{Theme / Spacing#spacing-3}" } },
        { "name": "chip-font-family", "type": "string", "valuesByMode": { "sm": "{Theme / Typography#text-xs/font-family}", "md": "{Theme / Typography#text-xs/font-family}", "lg": "{Theme / Typography#text-sm/font-family}" } },
        { "name": "chip-font-size", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Typography#text-xs/font-size}", "md": "{Theme / Typography#text-xs/font-size}", "lg": "{Theme / Typography#text-sm/font-size}" } },
        { "name": "chip-line-height", "type": "number", "unit": "unitless", "valuesByMode": { "sm": "{Theme / Typography#text-xs/line-height}", "md": "{Theme / Typography#text-xs/line-height}", "lg": "{Theme / Typography#text-sm/line-height}" } },
        { "name": "chip-letter-spacing", "type": "number", "unit": "em", "valuesByMode": { "sm": "{Theme / Typography#text-xs/letter-spacing}", "md": "{Theme / Typography#text-xs/letter-spacing}", "lg": "{Theme / Typography#text-sm/letter-spacing}" } },
        { "name": "chip-icon-size", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Core / Size#size-14}", "md": "{Core / Size#size-14}", "lg": "{Core / Size#size-16}" } },
        { "name": "chip-check-icon-size", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Core / Size#size-14}", "md": "{Core / Size#size-14}", "lg": "{Core / Size#size-16}" } },
        { "name": "chip-check-padding-inline-start", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Spacing#spacing-3}", "md": "{Theme / Spacing#spacing-3}", "lg": "{Theme / Spacing#spacing-4}" } }
      ]
    },
    {
      "name": "Chip List / Structure",
      "tier": 3,
      "prefix": "chip-list",
      "defaultMode": "Default",
      "modes": ["Default"],
      "tokens": [
        { "name": "input-min-inline-size", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Core / Size#size-80}" } },
        { "name": "text-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/1}" } },
        { "name": "placeholder-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/3}" } },
        { "name": "radius", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Radius#radius-md}" } },
        { "name": "border-width", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Border Width#border-width-1}" } },
        { "name": "border-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#border/2}" } },
        { "name": "hover-border-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#border/3}" } },
        { "name": "invalid-border-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#danger/color}" } },
        { "name": "bg", "type": "color", "valuesByMode": { "Default": "{Theme / Color#surface/1}" } },
        { "name": "readonly-bg", "type": "color", "valuesByMode": { "Default": "{Theme / Color#surface/2}" } },
        { "name": "readonly-chip-bg", "type": "color", "valuesByMode": { "Default": "{Theme / Color#surface/3}" } },
        { "name": "shadow", "type": "string", "valuesByMode": { "Default": "{Theme / Shadow#shadow-xs}" } },
        { "name": "focus-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#focus/2}" } },
        { "name": "focus-ring-width", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Core / Size#size-3}" } },
        { "name": "focus-ring-mix", "type": "number", "unit": "%", "valuesByMode": { "Default": "{Theme / Opacity#opacity-20}" } },
        { "name": "disabled-opacity", "type": "number", "unit": "%", "valuesByMode": { "Default": "{Theme / Opacity#opacity-50}" } }
      ]
    }
  ]
}
