    },
    {
      "name": "Chip List / Size",
      "tier": 3,
      "prefix": "chip-list",
      "defaultMode": "md",
      "modes": ["sm", "md", "lg"],
      "tokens": [{ "name": "chip-height", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Core / Size#size-28}", "md": "{Core / Size#size-32}", "lg": "{Core / Size#size-40}" } }]
