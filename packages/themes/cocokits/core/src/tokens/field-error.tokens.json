{
  "$meta": { "globalPrefix": "cck" },
  "collections": [
    {
      "name": "Field Error / Structure",
      "tier": 3,
      "prefix": "field-error",
      "defaultMode": "Default",
      "modes": ["Default"],
      "tokens": [
        { "name": "text-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#danger/text}" } },
        { "name": "font-family", "type": "string", "valuesByMode": { "Default": "{Theme / Typography#text-sm/font-family}" } },
        { "name": "font-size", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Typography#text-sm/font-size}" } },
        { "name": "line-height", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Typography#text-sm/line-height}" } },
        { "name": "letter-spacing", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Typography#text-sm/letter-spacing}" } },
        { "name": "font-weight", "type": "number", "unit": "unitless", "valuesByMode": { "Default": "{Core / Typography#font-weight/regular}" } }
      ]
    }
  ]
}
