{
  "$meta": { "globalPrefix": "cck" },
  "collections": [
    {
      "name": "Select / Size",
      "tier": 3,
      "prefix": "select",
      "defaultMode": "md",
      "modes": ["sm", "md", "lg"],
      "tokens": [
        { "name": "height", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Spacing#control-sm}", "md": "{Theme / Spacing#control-md}", "lg": "{Theme / Spacing#control-lg}" } },
        { "name": "padding-inline", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Spacing#spacing-4}", "md": "{Theme / Spacing#spacing-5}", "lg": "{Theme / Spacing#spacing-5}" } },
        { "name": "font-family", "type": "string", "valuesByMode": { "sm": "{Theme / Typography#text-sm/font-family}", "md": "{Theme / Typography#text-sm/font-family}", "lg": "{Theme / Typography#text-sm/font-family}" } },
        { "name": "font-size", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Typography#text-sm/font-size}", "md": "{Theme / Typography#text-sm/font-size}", "lg": "{Theme / Typography#text-sm/font-size}" } },
        { "name": "line-height", "type": "number", "unit": "unitless", "valuesByMode": { "sm": "{Theme / Typography#text-sm/line-height}", "md": "{Theme / Typography#text-sm/line-height}", "lg": "{Theme / Typography#text-sm/line-height}" } },
        { "name": "letter-spacing", "type": "number", "unit": "em", "valuesByMode": { "sm": "{Theme / Typography#text-sm/letter-spacing}", "md": "{Theme / Typography#text-sm/letter-spacing}", "lg": "{Theme / Typography#text-sm/letter-spacing}" } },
        { "name": "icon-size", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Core / Size#size-16}", "md": "{Core / Size#size-16}", "lg": "{Core / Size#size-20}" } }
      ]
    },
    {
      "name": "Select / Structure",
      "tier": 3,
      "prefix": "select",
      "defaultMode": "Default",
      "modes": ["Default"],
      "tokens": [
        { "name": "min-inline-size", "type": "number", "unit": "px", "valuesByMode": { "Default": 236 } },
        { "name": "gap", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-4}" } },
        { "name": "icon-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/3}" } },
        { "name": "value-font-weight", "type": "number", "unit": "unitless", "valuesByMode": { "Default": "{Core / Typography#font-weight/regular}" } },
        { "name": "text-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/1}" } },
        { "name": "placeholder-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/3}" } },
        { "name": "count-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/3}" } },
        { "name": "count-font-weight", "type": "number", "unit": "unitless", "valuesByMode": { "Default": "{Core / Typography#font-weight/regular}" } },
        { "name": "radius", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Radius#radius-md}" } },
        { "name": "border-width", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Border Width#border-width-1}" } },
        { "name": "border-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#border/2}" } },
        { "name": "hover-border-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#border/3}" } },
        { "name": "invalid-border-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#danger/color}" } },
        { "name": "bg", "type": "color", "valuesByMode": { "Default": "{Theme / Color#surface/1}" } },
        { "name": "readonly-bg", "type": "color", "valuesByMode": { "Default": "{Theme / Color#surface/2}" } },
        { "name": "shadow", "type": "string", "valuesByMode": { "Default": "{Theme / Shadow#shadow-xs}" } },
        { "name": "focus-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#focus/2}" } },
        { "name": "focus-ring-width", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Core / Size#size-3}" } },
        { "name": "focus-ring-mix", "type": "number", "unit": "%", "valuesByMode": { "Default": "{Theme / Opacity#opacity-20}" } },
        { "name": "disabled-opacity", "type": "number", "unit": "%", "valuesByMode": { "Default": "{Theme / Opacity#opacity-50}" } }
      ]
    },
    {
      "name": "Select__content / Structure",
      "tier": 3,
      "prefix": "select",
      "defaultMode": "Default",
      "modes": ["Default"],
      "tokens": [
        { "name": "content-bg", "type": "color", "valuesByMode": { "Default": "{Theme / Color#surface/1}" } },
        { "name": "content-text-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/1}" } },
        { "name": "content-border-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#border/1}" } },
        { "name": "content-border-width", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Border Width#border-width-1}" } },
        { "name": "content-radius", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Radius#radius-lg}" } },
        { "name": "content-shadow", "type": "string", "valuesByMode": { "Default": "{Theme / Shadow#shadow-lg}" } },
        { "name": "content-padding", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-3}" } },
        { "name": "content-side-offset", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-3}" } },
        { "name": "content-focus-width", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Border Width#border-width-2}" } },
        { "name": "content-font-family", "type": "string", "valuesByMode": { "Default": "{Theme / Typography#text-sm/font-family}" } },
        { "name": "content-font-size", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Typography#text-sm/font-size}" } },
        { "name": "content-line-height", "type": "number", "unit": "unitless", "valuesByMode": { "Default": "{Theme / Typography#text-sm/line-height}" } },
        { "name": "content-letter-spacing", "type": "number", "unit": "em", "valuesByMode": { "Default": "{Theme / Typography#text-sm/letter-spacing}" } },
        { "name": "content-motion-duration", "type": "string", "valuesByMode": { "Default": "150ms" } },
        { "name": "content-motion-distance", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-1}" } },
        { "name": "option-min-height", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#control-sm}" } },
        { "name": "option-padding-inline", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-4}" } },
        { "name": "option-padding-block", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-3}" } },
        { "name": "option-gap", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-4}" } },
        { "name": "option-radius", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Radius#radius-sm}" } },
        { "name": "option-font-weight", "type": "number", "unit": "unitless", "valuesByMode": { "Default": "{Core / Typography#font-weight/regular}" } },
        { "name": "option-highlight-bg", "type": "color", "valuesByMode": { "Default": "{Theme / Color#surface/2}" } },
        { "name": "option-selected-bg", "type": "color", "valuesByMode": { "Default": "{Theme / Color#surface/3}" } },
        { "name": "option-selected-highlight-bg", "type": "color", "valuesByMode": { "Default": "{Theme / Color#surface/4}" } },
        { "name": "option-selected-font-weight", "type": "number", "unit": "unitless", "valuesByMode": { "Default": "{Core / Typography#font-weight/medium}" } },
        { "name": "option-disabled-opacity", "type": "number", "unit": "%", "valuesByMode": { "Default": "{Theme / Opacity#opacity-50}" } },
        { "name": "indicator-size", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Core / Size#size-16}" } },
        { "name": "indicator-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/1}" } },
        { "name": "indicator-box-mark-size", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Core / Size#size-12}" } },
        { "name": "indicator-box-bg", "type": "color", "valuesByMode": { "Default": "{Theme / Color#surface/1}" } },
        { "name": "indicator-box-border-width", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Border Width#border-width-1}" } },
        { "name": "indicator-box-border-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#border/3}" } },
        { "name": "indicator-box-radius", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Radius#radius-sm}" } },
        { "name": "indicator-box-shadow", "type": "string", "valuesByMode": { "Default": "{Theme / Shadow#shadow-xs}" } },
        { "name": "indicator-box-checked-bg", "type": "color", "valuesByMode": { "Default": "{Theme / Color#brand/color}" } },
        { "name": "indicator-box-checked-mark-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#brand/on-color}" } },
        { "name": "group-label-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/3}" } },
        { "name": "group-label-font-size", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Typography#text-xs/font-size}" } },
        { "name": "group-label-line-height", "type": "number", "unit": "unitless", "valuesByMode": { "Default": "{Theme / Typography#text-xs/line-height}" } },
        { "name": "group-label-font-weight", "type": "number", "unit": "unitless", "valuesByMode": { "Default": "{Core / Typography#font-weight/medium}" } },
        { "name": "group-label-gap", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-3}" } },
        { "name": "group-label-padding-block", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-3}" } },
        { "name": "header-padding-inline", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-5}" } },
        { "name": "header-padding-block", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-4}" } },
        { "name": "header-gap", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-4}" } },
        { "name": "header-icon-size", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Core / Size#size-16}" } },
        { "name": "header-icon-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/3}" } },
        { "name": "search-text-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/1}" } },
        { "name": "search-placeholder-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/3}" } },
        { "name": "search-focus-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#focus/2}" } },
        { "name": "footer-padding", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-4}" } },
        { "name": "footer-gap", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-4}" } },
        { "name": "empty-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/3}" } },
        { "name": "empty-padding-block", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-6}" } },
        { "name": "option-leading-icon-size", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Core / Size#size-16}" } },
        { "name": "option-leading-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/3}" } },
        { "name": "option-description-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/3}" } },
        { "name": "option-description-font-family", "type": "string", "valuesByMode": { "Default": "{Theme / Typography#text-xs/font-family}" } },
        { "name": "option-description-font-size", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Typography#text-xs/font-size}" } },
        { "name": "option-description-line-height", "type": "number", "unit": "unitless", "valuesByMode": { "Default": "{Theme / Typography#text-xs/line-height}" } },
        { "name": "option-description-letter-spacing", "type": "number", "unit": "em", "valuesByMode": { "Default": "{Theme / Typography#text-xs/letter-spacing}" } },
        { "name": "option-description-font-weight", "type": "number", "unit": "unitless", "valuesByMode": { "Default": "{Core / Typography#font-weight/regular}" } }
