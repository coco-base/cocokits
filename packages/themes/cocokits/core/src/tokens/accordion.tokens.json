{
  "$meta": { "globalPrefix": "cck" },
  "collections": [
    {
      "name": "Accordion / Size",
      "tier": 3,
      "prefix": "accordion",
      "defaultMode": "md",
      "modes": ["sm", "md", "lg"],
      "tokens": [
        { "name": "trigger-padding-block", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Spacing#spacing-5}", "md": "{Theme / Spacing#spacing-6}", "lg": "{Theme / Spacing#spacing-7}" } },
        { "name": "padding-inline", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Spacing#spacing-5}", "md": "{Theme / Spacing#spacing-6}", "lg": "{Theme / Spacing#spacing-6}" } },
        { "name": "content-padding-block-start", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Spacing#spacing-3}", "md": "{Theme / Spacing#spacing-3}", "lg": "{Theme / Spacing#spacing-3}" } },
        { "name": "content-padding-block-end", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Spacing#spacing-5}", "md": "{Theme / Spacing#spacing-6}", "lg": "{Theme / Spacing#spacing-6}" } },
        { "name": "icon-size", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Core / Size#size-16}", "md": "{Core / Size#size-16}", "lg": "{Core / Size#size-16}" } },
        { "name": "font-family", "type": "string", "valuesByMode": { "sm": "{Theme / Typography#text-sm/font-family}", "md": "{Theme / Typography#text-sm/font-family}", "lg": "{Theme / Typography#text-sm/font-family}" } },
        { "name": "font-size", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Typography#text-sm/font-size}", "md": "{Theme / Typography#text-sm/font-size}", "lg": "{Theme / Typography#text-sm/font-size}" } },
        { "name": "line-height", "type": "number", "unit": "unitless", "valuesByMode": { "sm": "{Theme / Typography#text-sm/line-height}", "md": "{Theme / Typography#text-sm/line-height}", "lg": "{Theme / Typography#text-sm/line-height}" } },
        { "name": "letter-spacing", "type": "number", "unit": "em", "valuesByMode": { "sm": "{Theme / Typography#text-sm/letter-spacing}", "md": "{Theme / Typography#text-sm/letter-spacing}", "lg": "{Theme / Typography#text-sm/letter-spacing}" } }
      ]
    },
    {
      "name": "Accordion / Structure",
      "tier": 3,
      "prefix": "accordion",
      "defaultMode": "Default",
      "modes": ["Default"],
      "tokens": [
        { "name": "gap", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-4}" } },
        { "name": "radius", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Radius#radius-lg}" } },
        { "name": "border-width", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Border Width#border-width-1}" } },
        { "name": "border-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#border/1}" } },
        { "name": "bg", "type": "color", "valuesByMode": { "Default": "{Theme / Color#surface/1}" } },
        { "name": "basic-trigger-radius", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Radius#radius-sm}" } },
        { "name": "trigger-gap", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-4}" } },
        { "name": "trigger-font-weight", "type": "number", "unit": "unitless", "valuesByMode": { "Default": "{Core / Typography#font-weight/medium}" } },
        { "name": "trigger-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/1}" } },
        { "name": "trigger-hover-bg", "type": "color", "valuesByMode": { "Default": "{Theme / Color#surface/2}" } },
        { "name": "icon-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/3}" } },
        { "name": "content-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#text/2}" } },
        { "name": "disabled-opacity", "type": "number", "unit": "%", "valuesByMode": { "Default": "{Theme / Opacity#opacity-50}" } },
        { "name": "focus-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#focus/2}" } },
        { "name": "focus-width", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Border Width#border-width-2}" } },
        { "name": "focus-offset", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Spacing#spacing-2}" } },
        { "name": "motion-duration", "type": "string", "valuesByMode": { "Default": "200ms" } }
      ]
    }
  ]
}
