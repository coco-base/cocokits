{
  "$meta": { "globalPrefix": "cck" },
  "collections": [
    {
      "name": "Badge / Size",
      "tier": 3,
      "prefix": "badge",
      "defaultMode": "md",
      "modes": ["sm", "md", "lg", "xl"],
      "tokens": [
        { "name": "height", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Core / Size#size-16}", "md": "{Core / Size#size-20}", "lg": "{Core / Size#size-24}", "xl": "{Core / Size#size-28}" } },
        { "name": "padding-inline", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Core / Size#size-4}", "md": "{Core / Size#size-4}", "lg": "{Core / Size#size-8}", "xl": "{Core / Size#size-8}" } },
        { "name": "dot-size", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Core / Size#size-6}", "md": "{Core / Size#size-8}", "lg": "{Core / Size#size-10}", "xl": "{Core / Size#size-12}" } },
        { "name": "font-family", "type": "string", "valuesByMode": { "sm": "{Theme / Typography#text-2xs/font-family}", "md": "{Theme / Typography#text-xs/font-family}", "lg": "{Theme / Typography#text-xs/font-family}", "xl": "{Theme / Typography#text-sm/font-family}" } },
        { "name": "font-size", "type": "number", "unit": "px", "valuesByMode": { "sm": "{Theme / Typography#text-2xs/font-size}", "md": "{Theme / Typography#text-xs/font-size}", "lg": "{Theme / Typography#text-xs/font-size}", "xl": "{Theme / Typography#text-sm/font-size}" } },
        { "name": "line-height", "type": "number", "unit": "unitless", "valuesByMode": { "sm": "{Theme / Typography#text-2xs/line-height}", "md": "{Theme / Typography#text-xs/line-height}", "lg": "{Theme / Typography#text-xs/line-height}", "xl": "{Theme / Typography#text-sm/line-height}" } },
        { "name": "letter-spacing", "type": "number", "unit": "em", "valuesByMode": { "sm": "{Theme / Typography#text-2xs/letter-spacing}", "md": "{Theme / Typography#text-xs/letter-spacing}", "lg": "{Theme / Typography#text-xs/letter-spacing}", "xl": "{Theme / Typography#text-sm/letter-spacing}" } }
      ]
    },
    {
      "name": "Badge / Structure",
      "tier": 3,
      "prefix": "badge",
      "defaultMode": "Default",
      "modes": ["Default"],
      "tokens": [
        { "name": "radius-rounded", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Radius#radius-full}" } },
        { "name": "radius-rectangle", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Radius#radius-sm}" } },
        { "name": "bg", "type": "color", "valuesByMode": { "Default": "{Theme / Active Color#color}" } },
        { "name": "text-color", "type": "color", "valuesByMode": { "Default": "{Theme / Active Color#on-color}" } },
        { "name": "font-weight", "type": "number", "unit": "unitless", "valuesByMode": { "Default": "{Core / Typography#font-weight/medium}" } },
        { "name": "ring-width", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Border Width#border-width-2}" } },
        { "name": "ring-color", "type": "color", "valuesByMode": { "Default": "{Theme / Color#surface/1}" } }
      ]
    },
    {
      "name": "Badge Container / Structure",
      "tier": 3,
      "prefix": "badge-container",
      "defaultMode": "Default",
      "modes": ["Default"],
      "tokens": [{ "name": "host-radius", "type": "number", "unit": "px", "valuesByMode": { "Default": "{Theme / Radius#radius-md}" } }]
    }
  ]
}
