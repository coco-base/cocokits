{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "theme-cocokits-angular",
  "projectType": "library",
  "sourceRoot": "packages/themes/cocokits/angular/src",
  "tags": ["layer:theme", "scope:angular", "type:lib"],
  "targets": {
    "package": {
      "executor": "@nx/angular:package",
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/dist/packages/theme-cocokits-angular"],
      "options": {
        "project": "{projectRoot}/ng-package.json",
        "tsConfig": "{projectRoot}/tsconfig.lib.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "package"],
      "inputs": ["production", "^production", "{workspaceRoot}/tools/scripts/finalize-ng-package.mjs"],
      "outputs": ["{workspaceRoot}/dist/packages/theme-cocokits-angular"],
      "options": {
        "command": "node ../../../../tools/scripts/finalize-ng-package.mjs",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc --noEmit -p tsconfig.lib.json", "tsc --noEmit -p tsconfig.spec.json"],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "pack": {},
    "publint": {},
    "attw": {}
  }
}
