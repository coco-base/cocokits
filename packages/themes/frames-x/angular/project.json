{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "theme-frames-x-angular",
  "projectType": "library",
  "sourceRoot": "packages/themes/frames-x/angular/src",
  "tags": ["layer:theme", "scope:angular", "type:lib"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/packages/theme-frames-x-angular"],
      "options": {
        "project": "{projectRoot}/ng-package.json",
        "tsConfig": "{projectRoot}/tsconfig.lib.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc --noEmit -p tsconfig.lib.json"],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "pack": {},
    "publint": {},
    "attw": {}
  }
}
