{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "machines",
  "projectType": "library",
  "sourceRoot": "packages/machines",
  "tags": ["layer:machine", "scope:shared", "type:lib"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": ["tsdown -c tsdown.config.mjs --config-loader native"],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc --noEmit -p tsconfig.lib.json", "tsc --noEmit -p tsconfig.spec.json"],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "docs-data": {
      "executor": "@cocokits/workspace:docs-data",
      "options": {
        "source": "machines"
      }
    },
    "cycles": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.dependency-cruiser.cjs"],
      "options": {
        "command": "depcruise {projectRoot} --config .dependency-cruiser.cjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "dependsOn": ["cycles"]
    },
    "pack": {},
    "publint": {},
    "attw": {}
  }
}
