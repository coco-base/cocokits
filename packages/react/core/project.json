{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "react-core",
  "projectType": "library",
  "sourceRoot": "packages/react/core/src",
  "tags": ["layer:fw-core", "scope:react", "type:lib"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": ["tsdown -c tsdown.config.mjs --config-loader native"],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc --noEmit -p tsconfig.lib.json", "tsc --noEmit -p tsconfig.spec.json"],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    }
  }
}
