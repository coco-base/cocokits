{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "vue",
  "projectType": "library",
  "sourceRoot": "packages/vue/src",
  "tags": ["layer:fw-component", "scope:vue", "type:lib"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "vite build -c vite.config.lib.mjs",
          "vue-tsc -p tsconfig.lib.json --declaration --emitDeclarationOnly --noEmit false --outDir dist --rootDir src"
        ],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["vue-tsc --noEmit -p tsconfig.lib.json", "vue-tsc --noEmit -p tsconfig.spec.json"],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "api-docs": {
      "executor": "@cocokits/workspace:api-docs-vue"
    },
    "cycles": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.dependency-cruiser.cjs"],
      "options": {
        "command": "depcruise {projectRoot} --config .dependency-cruiser.cjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "dependsOn": ["cycles"]
    }
  }
}
