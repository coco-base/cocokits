{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "vue-core",
  "projectType": "library",
  "sourceRoot": "packages/vue/core/src",
  "tags": ["layer:fw-core", "scope:vue", "type:lib"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "vite build -c vite.config.lib.mjs",
          "vue-tsc -p tsconfig.lib.json --declaration --emitDeclarationOnly --noEmit false --outDir dist --rootDir src",
          "node ../../../tools/scripts/fix-declaration-imports.mjs dist"
        ],
        "cwd": "{projectRoot}",
        "parallel": false
      },
      "inputs": ["production", "^production", "{workspaceRoot}/tools/scripts/fix-declaration-imports.mjs"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["vue-tsc --noEmit -p tsconfig.lib.json", "vue-tsc --noEmit -p tsconfig.spec.json"],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "pack": {},
    "publint": {},
    "attw": {}
  }
}
