import { defineConfig, devices } from '@playwright/test';
import process from 'node:process';

/** The fixed port of the test server; the maintainer's dev servers use other ports. */
const PORT = 5130;
const origin = `http://127.0.0.1:${String(PORT)}`;
const chrome = process.env['CHROME_PATH'];

export default defineConfig({
  testDir: './tests',
  testMatch: '**/*.spec.ts',
  // The tests share one built site and one server, and some of them hold a page open on purpose: one worker.
  workers: 1,
  fullyParallel: false,
  // A test that walks a whole page with the keyboard (a preview frame reached backward) needs more than 30 seconds.
  timeout: 90_000,
  // A failing test fails; a retry would hide a flake.
  retries: 0,
  reporter: [['list']],
  use: {
    ...devices['Desktop Chrome'],
    baseURL: origin,
    viewport: { width: 1280, height: 900 },
    trace: 'retain-on-failure',
    // Playwright's own Chromium, or the browser that CHROME_PATH names.
    launchOptions: chrome === undefined ? { args: ['--no-sandbox'] } : { executablePath: chrome, args: ['--no-sandbox'] },
  },
  webServer: {
    // The docs app's own server script, run from the workspace root; it serves `apps/docs/dist`.
    command: `node apps/docs/scripts/serve-dist.mjs --port ${String(PORT)}`,
    cwd: '<%= offset %>',
    url: origin,
    reuseExistingServer: false,
    timeout: 30_000,
  },
});
