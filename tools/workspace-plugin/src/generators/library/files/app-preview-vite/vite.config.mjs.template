import { resolve } from 'node:path';
<%- pluginImport %>
import { defineConfig } from 'vite';

const root = import.meta.dirname;

export default defineConfig(({ command }) => ({
  root,
  plugins: [<%- pluginCall %>],
  // The docs build serves the app from this path; the dev server serves it at the root.
  base: command === 'build' ? '<%= baseHref %>' : '/',
  // Internal packages are bundled from their source (tsconfig paths).
  resolve: { tsconfigPaths: true },
  build: {
    // The build output is flat, so the docs build copies it as it is.
    outDir: resolve(root, '<%= offset %>dist/apps/<%= projectName %>'),
    emptyOutDir: true,
    target: 'es2022',
  },
}));
