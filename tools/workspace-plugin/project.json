{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "workspace",
  "projectType": "library",
  "sourceRoot": "tools/workspace-plugin/src",
  "tags": ["type:tool", "scope:shared"],
  "targets": {
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tools/scripts/package-manifest.mjs",
        "{workspaceRoot}/tools/eslint/**/*"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc --noEmit -p tsconfig.lib.json", "tsc --noEmit -p tsconfig.spec.json"],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "api-parity": {
      "executor": "@cocokits/workspace:api-parity",
      "dependsOn": ["angular:api-docs", "react:api-docs", "vue:api-docs"],
      "cache": true,
      "inputs": [
        "executors",
        {
          "dependentTasksOutputFiles": "**/*.json",
          "transitive": false
        }
      ]
    }
  }
}
