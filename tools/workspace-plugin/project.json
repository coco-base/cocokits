{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "workspace",
  "projectType": "library",
  "sourceRoot": "tools/workspace-plugin/src",
  "tags": ["type:tool", "scope:shared"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc --noEmit -p tsconfig.lib.json", "tsc --noEmit -p tsconfig.spec.json"],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    }
  }
}
